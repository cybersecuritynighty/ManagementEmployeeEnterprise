@model IEnumerable<MEE.ViewModels.OptimizationReportViewModel>

@{
    ViewData["Title"] = "Real Estate Optimization Analytics";
}

<h2 class="mb-4">Hybrid Workplace Real Estate Optimization</h2>

<div class="row">
@foreach (var item in Model) {
    var badgeColor = item.UtilizationRatePercentage < 35 ? "bg-danger" : (item.UtilizationRatePercentage < 65 ? "bg-warning text-dark" : "bg-success");
    <div class="col-md-6 mb-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title fw-bold mb-0">@item.WorkspaceName</h5>
                    <span class="badge @badgeColor">@item.UtilizationRatePercentage% Utilized</span>
                </div>
                <p class="text-muted small">Capacity: @item.Capacity Workstations | Lease Rate: $@item.CostPerSqFt/sq ft</p>
                
                <div class="progress mb-3" style="height: 12px;">
                    <div class="progress-bar @badgeColor" role="progressbar" style="width: @item.UtilizationRatePercentage%;" aria-valuenow="@item.UtilizationRatePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="row text-center my-3 bg-light p-2 rounded">
                    <div class="col-6 border-end">
                        <small class="text-muted d-block">Monthly Bookings</small>
                        <strong class="fs-5">@item.TotalBookingsThisMonth</strong>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Est. Idle Waste</small>
                        <strong class="fs-5 text-danger">$@item.WasteCostMonthly</strong>
                    </div>
                </div>

                <div class="alert alert-light border-start border-3 border-primary mb-0 py-2">
                    <small class="fw-bold">Recommendation:</small>
                    <p class="mb-0 small">@item.OptimizationRecommendation</p>
                </div>
            </div>
        </div>
    </div>
}
</div>
