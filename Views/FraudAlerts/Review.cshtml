@model MEE.ViewModels.FraudAlertReviewViewModel

@{
    ViewData["Title"] = "Investigate Fraud Alert";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 card p-4 shadow-sm">
        <h3 class="text-danger mb-3">Investigate Alert: @Model.RuleName</h3>
        <hr />

        <div class="row mb-3">
            <div class="col-md-6">
                <p><strong>Employee:</strong> @Model.EmployeeName</p>
                <p><strong>Timestamp:</strong> @Model.CheckInTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
                <p><strong>Severity Rating:</strong> <span class="badge bg-danger">Level @Model.SeverityLevel</span></p>
            </div>
            <div class="col-md-6">
                <p><strong>Captured Lat/Lon:</strong> @Model.LocationLat, @Model.LocationLon</p>
                <p><strong>Captured Device ID:</strong> <code>@Model.CapturedDeviceId</code></p>
                <p><strong>Registered Device ID:</strong> <code>@Model.RegisteredDeviceId</code></p>
            </div>
        </div>

        <div class="card bg-light p-3 mb-4">
            <h5>Geo-Verification</h5>
            <a href="https://maps.google.com/?q=@Model.LocationLat,@Model.LocationLon" target="_blank" class="btn btn-sm btn-outline-secondary col-md-4">
                View Check-In Map Position
            </a>
        </div>

        <form asp-action="ProcessReview" method="post">
            <input type="hidden" asp-for="AlertId" />

            <div class="form-group mb-4">
                <label class="form-label fw-bold">Select Review Determination</label>
                <select asp-for="ActionStatus" class="form-select">
                    <option value="ConfirmedFraud">Confirm Violation (Maintain Flag)</option>
                    <option value="Dismissed">Dismiss Violation (False Positive - Clear Flag)</option>
                </select>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Back to Inbox</a>
                <button type="submit" class="btn btn-danger">Submit Review Decision</button>
            </div>
        </form>
    </div>
</div>
