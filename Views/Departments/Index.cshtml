@model IEnumerable<MEE.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<h2>Department Management</h2>
<p><a asp-action="Create" class="btn btn-primary">Create New Department</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Name</td>
            <td>@item.CreatedAt.ToShortDateString()</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.DepartmentId">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.DepartmentId" class="text-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
